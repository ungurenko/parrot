{
  "name": "parrot",
  "private": true,
  "version": "0.4.31",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:ui": "vitest run",
    "check": "npm run test:ui && npm run build && npm run check:rust",
    "check:rust": "cd src-tauri && cargo test --locked && cargo fmt --check && cargo clippy --all-targets --all-features --locked -- -D warnings",
    "build:local": "tauri build && bash tools/sign_macos_bundle.sh",
    "preview": "vite preview",
    "release:mac": "node tools/release_mac.mjs",
    "release:latest-json": "node tools/generate_latest_json.mjs",
    "release:upload": "node tools/upload_release.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "shadcn": "^4.2.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.9"
  }
}
