{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parrot",
  "version": "0.1.3",
  "identifier": "com.alexk.parrot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Parrot",
        "width": 900,
        "height": 650,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "publisher": "Alexander Ungurenko",
    "copyright": "© 2026 Александр Унгуренко",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/yt-dlp"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBOEFFRjU1MTZDOUU0MDcKUldRSDVNa1dWZStLcXBodHNsdkQ0d1JUR295YmFJOGVObit2L2FwKzZvaXhuTHZMbGxCNldieCsK",
      "endpoints": [
        "https://github.com/ungurenko/parrot/releases/latest/download/latest.json"
      ]
    }
  }
}
